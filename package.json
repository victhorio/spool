{
  "name": "spool",
  "private": true,
  "type": "module",
  "workspaces": ["plugin", "web"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "web:build": "bun run --cwd web build",
    "web:validate": "bun dev/web-validate.ts",
    "reader:validate": "bun dev/reader-validate.ts",
    "retrieval:validate": "bun dev/retrieval-validate.ts",
    "local:up": "bun dev/stack.ts up",
    "local:down": "bun dev/stack.ts down",
    "validate": "bun dev/validate.ts"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
